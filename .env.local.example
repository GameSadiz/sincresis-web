# Copia este archivo a .env.local y completa con los valores de tu proyecto
# de Supabase (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Solo se usan en el servidor (rutas API), nunca se exponen al navegador.
# OPENAI_API_KEY: para transcribir con gpt-4o-transcribe-diarize.
# SUPABASE_SERVICE_ROLE_KEY: "Secret key" (Project Settings -> API Keys).
# Le permite a /api/transcribir leer el audio y guardar la transcripcion
# saltandose RLS (necesario porque el participante no tiene permiso de
# lectura sobre el bucket de audios).
OPENAI_API_KEY=sk-...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
