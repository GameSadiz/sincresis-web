# Copia este archivo a .env.local y completa con los valores de tu proyecto
# de Supabase (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# La transcripcion se hace localmente con IA, fuera de la app, asi que ya
# no hacen falta OPENAI_API_KEY ni SUPABASE_SERVICE_ROLE_KEY: todo lo que
# hace la pagina pasa por RLS con la sesion del miembro del equipo.
